# Copy this file to deploy.cloudflare.env and fill in the deployment settings.
# Keep CLOUDFLARE_API_TOKEN in your shell environment or CI secret store.

CLOUDFLARE_ACCOUNT_ID=
OSS_BASE_URL=https://your-bucket.example.com

CF_FRONTEND_WORKER_NAME=csboard-frontend
CF_BACKEND_WORKER_NAME=csboard-backend

# The frontend embeds this URL and uses it for API/WebSocket connections.
BACKEND_PUBLIC_URL=https://api.csboard.example.com

# Optional custom domains. Use hostnames only, without https://.
CF_FRONTEND_CUSTOM_DOMAIN=csboard.example.com
CF_BACKEND_CUSTOM_DOMAIN=api.csboard.example.com

# Set true to validate and write build/workers without uploading.
CF_DEPLOY_DRY_RUN=false
