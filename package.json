{
  "name": "csboard",
  "description": "CS2 demo analysis and visualization tool",
  "author": "colvin chen",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.csboard.app",
    "productName": "CSBoard",
    "directories": {
      "output": "build/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".local/maps",
        "to": "maps",
        "filter": ["**/*.glb"]
      }
    ],
    "mac": {
      "icon": "src/assets/favicon.svg",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    }
  },
  "scripts": {
    "dev": "npm run dev:node",
    "dev:workers": "node scripts/dev-workers.js",
    "dev:node": "npm run build:local && node server/node.js",
    "server": "node server/node.js",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "deploy:workers": "bash scripts/deploy-cloudflare.sh",
    "build": "npm run build:local",
    "build:local": "VITE_USE_LOCAL_MAPS=true VITE_BACKEND_BASE_URL=/ vite build",
    "build:remote": "VITE_USE_LOCAL_MAPS=false vite build",
    "build:desktop": "vite build",
    "nav:generate": "node scripts/generate-nav-data.js",
    "preview": "vite preview",
    "desktop:start": "electron .",
    "desktop:start:webmcp": "electron . --enable-csboard-webmcp",
    "desktop:build:mac": "npm run build:desktop && electron-builder --mac",
    "desktop:build:win": "npm run build:desktop && electron-builder --win",
    "desktop:build": "npm run build:desktop && electron-builder --mac --win"
  },
  "dependencies": {
    "@laihoe/demoparser2": "^0.42.0",
    "@vitejs/plugin-react": "latest",
    "lib0": "^0.2.114",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "three-mesh-bvh": "^0.9.14",
    "ws": "^8.21.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.1.0",
    "yjs": "latest"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "vite": "latest",
    "wrangler": "^4.37.1"
  }
}
