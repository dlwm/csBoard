{
  "name": "csboard",
  "description": "CS2 demo analysis and visualization tool",
  "author": "colvin chen",
  "license": "GPL-3.0-only",
  "private": true,
  "version": "1.16.2",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.csboard.app",
    "productName": "CSBoard",
    "directories": {
      "output": "build/desktop"
    },
    "files": [
      "electron/**/*",
      "LICENSE",
      "LICENSE_SCOPE.md",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "build/renderer/**/*",
      "build/icons/icon.png",
      "src/resources/catalog.json",
      "build/tasks/**/*"
    ],
    "extraResources": [
      {
        "from": "build/native/${os}-${arch}",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "beforePack": "scripts/check-native-package.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "scripts": {
    "dev": "npm run build && node server/node.js",
    "dev:workers": "node scripts/dev-workers.js",
    "server": "node server/node.js",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "build": "node scripts/build-frontend.js",
    "build:remote": "node scripts/build-frontend.js --remote",
    "desktop:start": "node scripts/start-desktop.js",
    "desktop:dev": "node scripts/package-desktop.js dev",
    "desktop:prepare": "node scripts/package-desktop.js prepare",
    "desktop:build:mac:arm64": "node scripts/package-desktop.js mac-arm64",
    "desktop:build:mac:x64": "node scripts/package-desktop.js mac-x64",
    "desktop:build:win:x64": "node scripts/package-desktop.js win-x64",
    "native:build": "node scripts/build-native.js"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@laihoe/demoparser2": "^0.42.0",
    "@vitejs/plugin-react": "latest",
    "lib0": "^0.2.114",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "three-mesh-bvh": "^0.9.14",
    "ws": "^8.21.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.1.0",
    "yjs": "latest"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "0.35.2",
    "vite": "latest",
    "wrangler": "^4.37.1"
  }
}
