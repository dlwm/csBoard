{
  "name": "csboard",
  "description": "CS2 demo analysis and visualization tool",
  "author": "colvin chen",
  "license": "GPL-3.0-only",
  "private": true,
  "version": "1.20.2",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.dlwm.csboard",
    "productName": "CSBoard",
    "directories": {
      "output": "build/desktop"
    },
    "files": [
      "electron/**/*",
      "shared/ai-protocol.js",
      "shared/ai-providers.js",
      "shared/record-keys.js",
      "shared/storage-codec.js",
      "LICENSE",
      "docs/THIRD_PARTY_NOTICES.md",
      "package.json",
      "build/renderer/**/*",
      "build/icons/icon.png",
      "src/resources/catalog.json",
      "build/tasks/**/*"
    ],
    "extraResources": [
      {
        "from": "build/native/${os}-${arch}",
        "to": "native",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/go-parser/native/${os}-${arch}",
        "to": "go-parser",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "binaries": [
        "Contents/Resources/native/csboard-native",
        "Contents/Resources/go-parser/csboard-go-parser"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "beforePack": "scripts/check-native-package.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "lib0": "^0.2.114",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "three-mesh-bvh": "^0.9.14",
    "ws": "^8.21.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.1.0",
    "yjs": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "0.35.2",
    "vite": "latest",
    "wrangler": "^4.37.1"
  }
}
