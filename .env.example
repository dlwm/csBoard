# Include the experimental operation assistant in ordinary web/desktop builds.
# 构建开关：false 排除 AI 界面、工具、提示词与语料。
CSBOARD_AI_ENABLED=true

# Public frontend build settings. These names are independent of the hosting platform.
# Leave VITE_BACKEND_BASE_URL empty when frontend and backend share one origin.
VITE_BACKEND_BASE_URL=

# Public object-storage origin that contains GLB files under /maps.
VITE_OSS_BASE_URL=https://your-object-storage.example.com

# Optional download-only override used by `make resources`.
MAP_DOWNLOAD_BASE_URL=

# Set true for a local build that reads GLB files from .local/official/maps.
# NAV data is always bundled into the frontend.
VITE_USE_LOCAL_MAPS=false

# Optional Node.js Runtime override. Compose sets this to its read-only mount.
LOCAL_MAPS_DIR=

# AI proxy destinations allowed by the server; never put API keys in VITE_* settings.
# Empty uses built-in provider presets; an explicit list replaces them.
AI_ALLOWED_BASE_URLS=
# Comma-separated frontend origins when frontend and backend use different hosts.
AI_ALLOWED_WEB_ORIGINS=
