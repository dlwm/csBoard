@@ -301 +303,29 @@ impl<'a> SecondPassParser<'a> {
-    pub fn insert_field(entity: &mut Entity, result: Variant, field_info: Option<FieldInfo>) {
+    pub fn insert_field(entity: &mut Entity, result: Variant, field_info: Option<FieldInfo>, field: &Field, path: &FieldPath) {
+        // Network vectors arrive as individual element updates. Preserve the complete
+        // smoke journal instead of overwriting the property with the last decoded byte.
+        if let (Some(fi), Field::Vector(vector), Variant::U32(length)) = (field_info, field, &result) {
+            if let Field::Value(value) = vector.field_enum.as_ref() {
+                if fi.should_parse && value.full_name.ends_with(".m_VoxelFrameData") {
+                    let stored = entity.props.entry(fi.prop_id).or_insert_with(|| Variant::U32Vec(Vec::new()));
+                    if let Variant::U32Vec(bytes) = stored {
+                        bytes.resize(*length as usize, 0);
+                    }
+                    return;
+                }
+            }
+        }
+        if let (Some(fi), Field::Value(value), Variant::U32(byte)) = (field_info, field, &result) {
+            if fi.should_parse && value.full_name.ends_with(".m_VoxelFrameData") && path.last > 0 {
+                let index = path.path[path.last] as usize;
+                let stored = entity.props.entry(fi.prop_id).or_insert_with(|| Variant::U32Vec(Vec::new()));
+                let bytes = match stored {
+                    Variant::U32Vec(bytes) => bytes,
+                    _ => return,
+                };
+                if bytes.len() <= index {
+                    bytes.resize(index + 1, 0);
+                }
+                bytes[index] = *byte;
+                return;
+            }
+        }
