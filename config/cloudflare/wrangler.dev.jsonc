{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "csboard",
  "main": "../../server/index.js",
  // Minification removes the disabled AI branch and its module dependencies.
  "minify": true,
  "define": { "__CSBOARD_AI_ENABLED__": "false" },
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "cwd": ".",
    "watch_dir": "../../src",
    "command": "VITE_OSS_BASE_URL=http://localhost:3002 VITE_BACKEND_BASE_URL=/ node scripts/build-worker-frontend.js"
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/rooms/*"]
  },
  "vars": {
    "MAP_BASE_URL": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ]
}
