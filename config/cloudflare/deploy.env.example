# Optional local settings. OAuth login and deployment URLs are automatic.
# For CI, supply CLOUDFLARE_API_TOKEN through the secret store.

# Optional: a single account is selected automatically after OAuth login.
CLOUDFLARE_ACCOUNT_ID=
# Leave empty to reuse VITE_OSS_BASE_URL from existing frontend settings.
OSS_BASE_URL=

CF_FRONTEND_WORKER_NAME=csboard-frontend
CF_BACKEND_WORKER_NAME=csboard-backend

# Optional override; otherwise use the deployed URL or backend custom domain.
BACKEND_PUBLIC_URL=

# Optional custom domains. Use hostnames only, without https://.
CF_FRONTEND_CUSTOM_DOMAIN=
CF_BACKEND_CUSTOM_DOMAIN=

# Cloudflare builds exclude experimental AI by default; true enables frontend and backend together.
# CF 部署默认不含 AI；true 同时启用前端助手和后端代理。
CF_AI_ENABLED=false

# Only used when CF_AI_ENABLED=true.
# Empty uses the built-in provider presets. An explicit list replaces the defaults.
# Custom service base URLs can be included in that comma-separated list.
AI_ALLOWED_BASE_URLS=
AI_ALLOWED_WEB_ORIGINS=

# Set true to validate and write build/workers without uploading.
CF_DEPLOY_DRY_RUN=false
