{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "csboard-backend",
  "main": "../../server/index.js",
  // Minification removes the disabled AI branch and its module dependencies.
  "minify": true,
  "define": { "__CSBOARD_AI_ENABLED__": "false" },
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MAP_BASE_URL": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ]
}
